#!/usr/bin/env bash
#
# pre-push hook: 只做一件事——核对门禁标记。
#
# 门禁（build → unit test → 全量 QA）不在钩子里跑，由 scripts/push 在 git push 之前
# 跑完，通过后把验证过的提交号写进标记文件 <git-dir>/fly-push-marker。这里检查标记
# 文件里的提交号与本次推送的提交是否一致：
#
#   一致   → 放行
#   不一致 → 报错退出，并说明正确的推送方式
#
# 为什么不在钩子里跑门禁：git push 的顺序是「连接远端 → 运行本钩子 → 传输」，门禁
# 跑多久连接就空闲多久，超过约 6 分钟时远端会关闭空闲连接，钩子通过之后 git push
# 以退出码 141 失败（见 docs/push-hook.md）。
#
# 禁止以 git push --no-verify 绕过 —— 见 docs/push-hook.md。
#

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

MARKER="$(git rev-parse --absolute-git-dir)/fly-push-marker"
PUSH_CMD="./scripts/push"

# git 从标准输入喂入要更新的引用，每行：本地引用 本地对象号 远端引用 远端对象号
# （删除远端引用时本地对象号全是 0）
REFS=()
while read -r local_ref local_sha remote_ref remote_sha || [ -n "${local_ref:-}" ]; do
    [ -n "${local_ref:-}" ] || continue
    REFS+=("$local_ref $local_sha $remote_ref")
done

block() {
    # $1: 标记文件的情况
    echo
    echo "============================== PUSH BLOCKED =============================="
    echo "  本次推送没有对应的门禁标记，push 已阻止。"
    echo
    echo "  标记文件：$MARKER"
    echo "    $1"
    if [ "${#REFS[@]}" -gt 0 ]; then
        echo "  本次推送的引用（本地引用 本地对象号 -> 远端引用）："
        for line in "${REFS[@]}"; do
            read -r local_ref local_sha remote_ref <<< "$line"
            echo "    $local_ref  $local_sha  ->  $remote_ref"
        done
    fi
    echo
    echo "  正确的推送方式：不要直接用 git push。用项目的推送命令——它先跑"
    echo "  build -> unit test -> 全量 QA，全部通过后把提交号写进上面的标记文件，再推送："
    echo
    echo "      $PUSH_CMD                # 参数与 git push 相同，例如 $PUSH_CMD origin main"
    echo
    echo "  标记文件里的提交号必须与本次推送的提交一致。门禁验证的是当前检出的提交，"
    echo "  只能推送指向它的引用；换了提交就要重新跑一遍 $PUSH_CMD。"
    echo "  禁止用 git push --no-verify 绕过。"
    echo "=========================================================================="
    exit 1
}

# --- 标记文件 --------------------------------------------------------------------
MARKER_COMMIT=""
MARKER_STATE="不存在（没有跑过门禁，或者标记被删掉了）"
if [ -f "$MARKER" ]; then
    MARKER_COMMIT="$(tr -d '[:space:]' < "$MARKER")"
    if [[ "$MARKER_COMMIT" =~ ^[0-9a-f]{40}$ ]]; then
        MARKER_STATE="记录的提交：$MARKER_COMMIT"
    else
        MARKER_STATE="内容不是提交号：${MARKER_COMMIT:-（空文件）}"
        MARKER_COMMIT=""
    fi
fi
[ -n "$MARKER_COMMIT" ] || block "$MARKER_STATE"

# --- 逐个引用核对 ----------------------------------------------------------------
# 删除远端引用不推送内容，跳过核对；其余每个引用都必须指向标记里的提交。
# 附注标签的对象号是标签对象自己的，先解析到它指向的提交再比较。
PUSHES_CONTENT=0
if [ "${#REFS[@]}" -gt 0 ]; then
    for line in "${REFS[@]}"; do
        read -r local_ref local_sha remote_ref <<< "$line"
        if [[ "$local_sha" =~ ^0+$ ]]; then
            continue
        fi
        PUSHES_CONTENT=1
        COMMIT="$(git rev-parse --verify --quiet "$local_sha^{commit}" || true)"
        if [ -z "$COMMIT" ]; then
            block "$MARKER_STATE
    本次推送的 $local_ref（$local_sha）不是一个提交"
        fi
        if [ "$COMMIT" != "$MARKER_COMMIT" ]; then
            block "$MARKER_STATE
    本次推送的提交：$COMMIT（$local_ref）——与标记不一致"
        fi
    done
fi

if [ "$PUSHES_CONTENT" = "1" ]; then
    echo "=== [pre-push] 门禁标记与本次推送的提交一致（${MARKER_COMMIT:0:7}），放行 ==="
else
    echo "=== [pre-push] 本次只删除远端引用、不推送内容；标记文件存在（${MARKER_COMMIT:0:7}），放行 ==="
fi
exit 0
