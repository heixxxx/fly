package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_library")

# genrule: 在构建时生成 build_info.h，注入 git commit、build type、build timestamp。
# local = True 禁用 sandbox：genrule 在工作区执行，git 命令能访问 .git 目录。
# 这与项目布局耦合（构建必在工作区内），对 fly 的本地开发模式可接受。
genrule(
    name = "build_info_header",
    srcs = [],
    outs = ["build_info.h"],
    cmd = "commit=$$(git describe --tags --always --dirty 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || echo unknown) && " +
          "build_type=$$(case $(COMPILATION_MODE) in opt) echo release;; dbg) echo debug;; *) echo fastbuild;; esac) && " +
          "build_time=$$(date '+%Y-%m-%d %H:%M:%S') && " +
          "echo '#pragma once' > $@ && " +
          "echo '// Auto-generated by bazel genrule. Do not edit.' >> $@ && " +
          "echo 'namespace fly { namespace build_info {' >> $@ && " +
          "echo \"inline constexpr const char* kGitCommit = \\\"$$commit\\\";\" >> $@ && " +
          "echo \"inline constexpr const char* kBuildType = \\\"$$build_type\\\";\" >> $@ && " +
          "echo \"inline constexpr const char* kBuildTime = \\\"$$build_time\\\";\" >> $@ && " +
          "echo '} }' >> $@",
    local = True,
)

# Header-only target: 让其他 cc_library 通过 deps 引用 build_info.h。
cc_library(
    name = "fly_build_info",
    hdrs = [":build_info_header"],
    strip_include_prefix = "/src",
    copts = ["-std=c++20"],
)
