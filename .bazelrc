# C++20 standard (both C and C++ flags for toolchain compatibility)
build --copt=-std=c++20
build --host_cxxopt=-std=c++20

# Preserve PATH for toolchain discovery
build --action_env=PATH

# Test output
test --test_output=errors

# GCC 12 toolchain
build --repo_env=CC=gcc-12
build --repo_env=CXX=g++-12

# Release mode: eliminate DBG logs at compile time
build:opt --copt=-DFLY_RELEASE
build:opt --compilation_mode=opt

# Coverage: sandbox hides gcno files, use standalone spawn strategy
build:coverage --spawn_strategy=standalone
build:coverage --copt=--coverage
build:coverage --linkopt=--coverage

# Test: sandbox（linux-sandbox）在全量并行 py_test 时偶发截断 src/*/__init__.py 为 0 字节
# （inotifywait 抓到 MODIFY；--spawn_strategy=standalone 不复现）。截断破坏 Python 包 re-export
# 链 → py_test ImportError flaky。fly.sh guard_init_py 只在 bazel 操作前自愈，操作中截断来不及。
# 用 standalone 绕过 sandbox（同 coverage 思路）。副作用：test 不隔离（共享 fs/port），但全量
# 55 test standalone 验证通过（含 cc_test + py_test）。
test --spawn_strategy=standalone

# TSAN（opt-in，P3-17 批 3，2026-09-04）：并发测试动态分析。3-10x 减速——
# 仅对指定 target 使用（./fly.sh test --config=tsan //path:target），不进门禁。
# WSL2 常见 ASLR 熵冲突（"FATAL: ThreadSanitizer unexpected memory mapping"），
# 需一次性 sysctl vm.mmap_rnd_bits=28（特权，机器相关）。
build:tsan --copt=-fsanitize=thread
build:tsan --linkopt=-fsanitize=thread
build:tsan --spawn_strategy=standalone

# Python paths (auto-generated by fly.sh, machine-specific)
# DO NOT add Python include/link flags here - they come from .bazelrc.user
try-import %workspace%/.bazelrc.user
