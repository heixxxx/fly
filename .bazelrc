# C++20 standard (both C and C++ flags for toolchain compatibility)
build --copt=-std=c++20
build --host_cxxopt=-std=c++20

# Preserve PATH for toolchain discovery
build --action_env=PATH

# Test output
test --test_output=errors

# GCC 12 toolchain
build --repo_env=CC=gcc-12
build --repo_env=CXX=g++-12

# Python paths (auto-generated by fly.sh, machine-specific)
# DO NOT add Python include/link flags here - they come from .bazelrc.user
try-import %workspace%/.bazelrc.user
