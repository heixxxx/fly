# open-mem: Auto-generated folder context files.
# Uncomment to exclude from version control (recommended for large projects):
# **/AGENTS.md
# QA test logs & run artifacts.
# runqa writes per-test output to {test_dir}/{test_name}/ — these dirs are
# produced at test time, never source. Match both bare names (test_foo/) and
# numeric-suffix rerun dirs (test_foo.1/, test_foo.2/). The trailing content
# rules below catch stragglers (.fly_config, failed_tasks.bin, etc.).
qa/*/test_*/
qa/**/test_*/
qa/*/test_*.[0-9]*
qa/**/test_*.[0-9]*
qa/**/logs/
qa/**/.fly_config_*
qa/**/failed_tasks.bin
qa/logs/
massif.out.*
.omo/run-continuation
.open-mem
.fly_config
_test_db_id
# ZCode agent session artifacts
.zcode/
# Coverage data artifacts (gcov/coverage.py 残留，勿提交)
.coverage
.coverage.*
*.gcda
*.gcno
qa/var/persistence_db/
