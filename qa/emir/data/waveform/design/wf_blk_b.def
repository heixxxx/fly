VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN wf_blk_b ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 16000 8000 ) ;

COMPONENTS 3 ;
    - u_dff_b1 DFFR_X1 + PLACED ( 2000 2000 ) N ;
    - u_buf_b BUF_X1 + PLACED ( 4000 2000 ) N ;
    - u_inv_b INV_X1 + PLACED ( 6000 2000 ) N ;
END COMPONENTS

PINS 3 ;
    - clk + NET clk
      + DIRECTION INPUT + USE CLOCK
      + LAYER metal1 ( -50 -50 ) ( 50 50 )
      + FIXED ( 2000 7000 ) N ;
    - rn + NET rn
      + DIRECTION INPUT + USE SIGNAL
      + LAYER metal1 ( -50 -50 ) ( 50 50 )
      + FIXED ( 6000 7000 ) N ;
    - n_out + NET n_out
      + DIRECTION OUTPUT + USE SIGNAL
      + LAYER metal1 ( -50 -50 ) ( 50 50 )
      + FIXED ( 10000 7000 ) N ;
END PINS

NETS 5 ;
    - n_b2 ( u_dff_b1 D ) ( u_buf_b Z ) ;
    - clk ( u_dff_b1 CK ) ( PIN clk ) ;
    - rn ( u_dff_b1 RN ) ( PIN rn ) ;
    - n_b1 ( u_dff_b1 Q ) ( u_buf_b A ) ( u_inv_b A ) ;
    - n_out ( u_inv_b ZN ) ( PIN n_out ) ;
END NETS

END DESIGN
