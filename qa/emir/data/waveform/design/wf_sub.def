VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN wf_sub ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 12000 8000 ) ;

COMPONENTS 3 ;
    - u_dff_s DFFR_X1 + PLACED ( 2000 2000 ) N ;
    - u_xor_s XOR2_X1 + PLACED ( 4000 2000 ) N ;
    - u_inv_s INV_X1 + PLACED ( 6000 2000 ) N ;
END COMPONENTS

PINS 3 ;
    - clk + NET clk
      + DIRECTION INPUT + USE CLOCK
      + LAYER metal1 ( -50 -50 ) ( 50 50 )
      + FIXED ( 2000 7000 ) N ;
    - rn + NET rn
      + DIRECTION INPUT + USE SIGNAL
      + LAYER metal1 ( -50 -50 ) ( 50 50 )
      + FIXED ( 6000 7000 ) N ;
    - n_in + NET n_in
      + DIRECTION INPUT + USE SIGNAL
      + LAYER metal1 ( -50 -50 ) ( 50 50 )
      + FIXED ( 10000 7000 ) N ;
END PINS

NETS 6 ;
    - n2 ( u_dff_s D ) ( u_inv_s ZN ) ;
    - clk ( u_dff_s CK ) ( PIN clk ) ;
    - rn ( u_dff_s RN ) ( PIN rn ) ;
    - n1 ( u_dff_s Q ) ( u_xor_s A ) ;
    - n_in ( u_xor_s B ) ( PIN n_in ) ;
    - n3 ( u_xor_s Z ) ( u_inv_s A ) ;
END NETS

END DESIGN
