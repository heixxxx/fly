library (minitest_typ) {
  time_unit : "1ns";
  voltage_unit : "1V";
  capacitive_load_unit (1, pf);
  cell (DFF_X1) {
    area : 8.5;
    ff (IQ, IQN) {
      clocked_on : CK;
      next_state : D;
    }
    pin (CK) {
      direction : input;
      capacitance : 2.0;
    }
    pin (Q) {
      direction : output;
      capacitance : 0.0;
    }
  }
}
