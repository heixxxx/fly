*SPEF "IEEE 1481-1998"
*DESIGN "wf_blk_top"
*DIVIDER /
*DELIMITER :
*T_UNIT 1 NS
*C_UNIT 1 FF
*R_UNIT 1 OHM

// 顶层文件（纯路径形态）：网名是展平后的层次路径。

*D_NET u_blk_a/n_a1 10
*CONN
*I u_blk_a/u_dff_a:Q O *D DFFR_X1
*I u_blk_a/u_inv1:A I *D INV_X1
*I u_blk_a/u_inv_out:A I *D INV_X1
*I u_blk_a/u_sub/n_in B *D wf_sub
*CAP
1 u_blk_a/n_a1:1 6
2 u_blk_a/n_a1:1 u_blk_a/u_dff_a:D:1 4
*RES
1 u_blk_a/n_a1:1 u_blk_a/n_a1:2 1
*END

*D_NET u_blk_a/n_a2 20
*CAP
1 u_blk_a/n_a2:1 12
2 u_blk_a/n_a2:1 u_blk_a/clk:1 8
*END

*D_NET u_blk_a/n_out 30
*CAP
1 u_blk_a/n_out:1 18
2 u_blk_a/n_out:1 u_blk_a/n_a1:1 12
*END

*D_NET u_blk_a/u_sub/n1 40
*CAP
1 u_blk_a/u_sub/n1:1 24
2 u_blk_a/u_sub/n1:1 u_blk_a/u_sub/n3:1 16
*END

*D_NET u_blk_b/n_b1 50
*CAP
1 u_blk_b/n_b1:1 30
2 u_blk_b/n_b1:1 u_blk_b/n_b2:1 20
*END

*D_NET n_top 60
*CONN
*I u_blk_a/n_out O *D wf_blk_a
*P n_top O
*CAP
1 n_top:1 36
2 n_top:1 n_top2:1 24
*END

*D_NET n_top2 70
*CAP
1 n_top2:1 42
2 n_top2:1 n_top:1 28
*END

*D_NET clk 80
*CONN
*I u_blk_a/clk B *D wf_blk_a
*I u_blk_b/clk B *D wf_blk_b
*P clk I
*CAP
1 clk:1 48
2 clk:1 rn:1 32
*END

*D_NET rn 90
*CAP
1 rn:1 54
2 rn:1 clk:1 36
*END

// 设计里没有的网。
*D_NET ghost_top 5.0
*CAP
1 ghost_top:1 3.0
2 ghost_top:1 n_top:1 2.0
*END
