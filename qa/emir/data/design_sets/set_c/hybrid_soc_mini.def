      + USE SIGNAL
      + PORT
        + LAYER metal2 ( -100 -100 ) ( 100 100 )
        + FIXED ( 9400 1000 ) N ;
    - a7 + NET a7
      + DIRECTION INPUT
      + USE SIGNAL
      + PORT
        + LAYER metal2 ( -100 -100 ) ( 100 100 )
        + FIXED ( 9800 1000 ) N ;
    - y0 + NET y0
      + DIRECTION OUTPUT
      + USE SIGNAL
      + PORT
        + LAYER metal2 ( -100 -100 ) ( 100 100 )
        + FIXED ( 1000 2000 ) N ;
    - y1 + NET y1
