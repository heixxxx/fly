    - y_b1 BUF_X2 + PLACED ( 21200 105600 ) N ;
    - u_ctrl ctrl_block + PLACED ( 21600 105600 ) N ;
END COMPONENTS

PINS 13 ;
    - clk_core + NET clk_core
      + DIRECTION INPUT
      + USE SIGNAL
      + PORT
        + LAYER metal2 ( -100 -100 ) ( 100 100 )
        + FIXED ( 1000 1000 ) N ;
    - clk_noc + NET clk_noc
      + DIRECTION INPUT
      + USE SIGNAL
      + PORT
        + LAYER metal2 ( -100 -100 ) ( 100 100 )
        + FIXED ( 3000 1000 ) N ;
