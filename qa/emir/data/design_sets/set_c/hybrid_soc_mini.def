VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN hybrid_soc ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 34000 254000 ) ;

COMPONENTS 50 ;
    - ccb_root CLKBUF_X3 + PLACED ( 2000 102800 ) N ;
    - ccb_r_0 CLKBUF_X2 + PLACED ( 2400 102800 ) N ;
    - ccb_r_1 CLKBUF_X2 + PLACED ( 2800 102800 ) N ;
    - ncb_root CLKBUF_X3 + PLACED ( 3200 102800 ) N ;
    - ncb_r_0 CLKBUF_X2 + PLACED ( 3600 102800 ) N ;
    - ncb_r_1 CLKBUF_X2 + PLACED ( 4000 102800 ) N ;
    - kcb_root CLKBUF_X3 + PLACED ( 4400 102800 ) N ;
