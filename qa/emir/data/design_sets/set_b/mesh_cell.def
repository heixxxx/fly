    - arb_i_s INV_X1 + PLACED ( 2200 7600 ) N ;
    - lp_w0 DFF_X1 + PLACED ( 2600 7600 ) N ;
    - rt_w0 DFF_X1 + PLACED ( 3000 7600 ) N ;
    - lp_w1 DFF_X1 + PLACED ( 3400 7600 ) N ;
    - rt_w1 DFF_X1 + PLACED ( 3800 7600 ) N ;
    - arb_x_w XOR2_X1 + PLACED ( 4200 7600 ) N ;
    - arb_a_w AND2_X1 + PLACED ( 4600 7600 ) N ;
    - arb_o_w OR2_X1 + PLACED ( 1000 10400 ) N ;
    - arb_i_w INV_X1 + PLACED ( 1400 10400 ) N ;
    - lp_loc0 DFF_X1 + PLACED ( 1800 10400 ) N ;
    - rt_loc0 DFF_X1 + PLACED ( 2200 10400 ) N ;
    - lp_loc1 DFF_X1 + PLACED ( 2600 10400 ) N ;
    - rt_loc1 DFF_X1 + PLACED ( 3000 10400 ) N ;
    - arb_x_loc XOR2_X1 + PLACED ( 3400 10400 ) N ;
    - arb_a_loc AND2_X1 + PLACED ( 3800 10400 ) N ;
    - arb_o_loc OR2_X1 + PLACED ( 4200 10400 ) N ;
    - arb_i_loc INV_X1 + PLACED ( 4600 10400 ) N ;
    - xb_n0 MUX2_X1 + PLACED ( 1000 13200 ) N ;
    - xb_n1 MUX2_X1 + PLACED ( 1400 13200 ) N ;
    - xb_e0 MUX2_X1 + PLACED ( 1800 13200 ) N ;
    - xb_e1 MUX2_X1 + PLACED ( 2200 13200 ) N ;
    - xb_s0 MUX2_X1 + PLACED ( 2600 13200 ) N ;
    - xb_s1 MUX2_X1 + PLACED ( 3000 13200 ) N ;
    - xb_w0 MUX2_X1 + PLACED ( 3400 13200 ) N ;
    - xb_w1 MUX2_X1 + PLACED ( 3800 13200 ) N ;
    - xb_loc0 MUX2_X1 + PLACED ( 4200 13200 ) N ;
    - xb_loc1 MUX2_X1 + PLACED ( 4600 13200 ) N ;
END COMPONENTS

PINS 22 ;
    - clk_noc + NET clk_noc
      + DIRECTION INPUT
      + USE SIGNAL
      + PORT
        + LAYER metal2 ( -100 -100 ) ( 100 100 )
        + FIXED ( 500 0 ) N ;
    - clk_cfg + NET clk_cfg
      + DIRECTION INPUT
      + USE SIGNAL
      + PORT
        + LAYER metal2 ( -100 -100 ) ( 100 100 )
        + FIXED ( 900 0 ) N ;
    - flit_in_n0 + NET flit_in_n0
      + DIRECTION INPUT
      + USE SIGNAL
      + PORT
        + LAYER metal2 ( -100 -100 ) ( 100 100 )
        + FIXED ( 1300 0 ) N ;
    - flit_out_n0 + NET flit_out_n0
