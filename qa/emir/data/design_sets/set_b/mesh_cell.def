    - rt_e1 DFF_X1 + PLACED ( 1400 4800 ) N ;
    - arb_x_e XOR2_X1 + PLACED ( 1800 4800 ) N ;
    - arb_a_e AND2_X1 + PLACED ( 2200 4800 ) N ;
    - arb_o_e OR2_X1 + PLACED ( 2600 4800 ) N ;
    - arb_i_e INV_X1 + PLACED ( 3000 4800 ) N ;
    - lp_s0 DFF_X1 + PLACED ( 3400 4800 ) N ;
