      + USE SIGNAL
      + PORT
        + LAYER metal2 ( -100 -100 ) ( 100 100 )
        + FIXED ( 3700 0 ) N ;
    - flit_out_e1 + NET flit_out_e1
      + DIRECTION OUTPUT
      + USE SIGNAL
      + PORT
        + LAYER metal2 ( -100 -100 ) ( 100 100 )
        + FIXED ( 4100 0 ) N ;
    - flit_in_s0 + NET flit_in_s0
