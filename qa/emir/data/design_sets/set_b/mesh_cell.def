VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN mesh_cell ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 5000 18800 ) ;

COMPONENTS 50 ;
    - lp_n0 DFF_X1 + PLACED ( 1000 2000 ) N ;
    - rt_n0 DFF_X1 + PLACED ( 1400 2000 ) N ;
    - lp_n1 DFF_X1 + PLACED ( 1800 2000 ) N ;
    - rt_n1 DFF_X1 + PLACED ( 2200 2000 ) N ;
    - arb_x_n XOR2_X1 + PLACED ( 2600 2000 ) N ;
    - arb_a_n AND2_X1 + PLACED ( 3000 2000 ) N ;
    - arb_o_n OR2_X1 + PLACED ( 3400 2000 ) N ;
    - arb_i_n INV_X1 + PLACED ( 3800 2000 ) N ;
