#!/usr/bin/env python3
"""Fly QA Test Runner.

Runs each test_*.py as a fly subprocess.
  - cd to test script directory before running
  - log directory: {test_dir}/{test_name}/ (cleaned before each run)
  - Fly's output → {test_dir}/{test_name}/fly.log
  - Runner's output → terminal + qa.log

Selecting which tests to run (zero, one, or many positional args):
  runqa                        # all test_*.py under qa/ (recursive)
  runqa qa/storage             # a directory → every test_*.py under it
  runqa qa/storage/test_x.py   # a single file
  runqa qa/storage qa/var      # multiple directories/files at once
  runqa qa/solver/test_gold*.py  # shell-globbed files also accepted

A directory is scanned recursively for test_*.py; an explicit .py file is run
as-is regardless of its name. Non-existent paths are rejected up front instead
of being passed to fly and failing with an opaque error.
"""
import subprocess
import sys
import os
import time
import argparse
import signal
import shutil
import threading
from concurrent.futures import ThreadPoolExecutor, as_completed

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
FLY_BIN = os.path.join(PROJECT_ROOT, "build", "bin", "fly")

_log_lock = threading.Lock()
_log_file = None


def log(msg=""):
    with _log_lock:
        print(msg, flush=True)
        if _log_file:
            _log_file.write(msg + "\n")
            _log_file.flush()


def find_tests():
    """Discover every test_*.py under qa/, returning canonical real paths.

    Uses os.walk(followlinks=False) instead of glob('**') because glob's '**'
    follows symlinked directories — a '{dir}.latest -> {dir}' symlink (fly's
    standard log-dir artifact) would make every test under {dir} appear twice,
    once per path, breaking de-duplication and causing parallel DB-path
    collisions. We also skip fly's log artifacts ('.latest', '*.N', 'logs')
    so only real test sources are collected.
    """
    tests = set()
    for root, dirs, files in os.walk(SCRIPT_DIR, followlinks=False):
        # Skip log-residue entries in-place so os.walk doesn't descend into them.
        dirs[:] = [d for d in dirs if not _is_log_artifact(d)]
        # .pyt 是 case 入口（编排脚本）；同 stem 的 test_*.py 被 .pyt 接管，
        # 退为 sub case 脚本（被 .pyt 调），不独立发现。
        pyt_stems = {os.path.splitext(f)[0] for f in files if f.endswith(".pyt")}
        for f in files:
            if f.endswith(".pyt"):
                tests.add(os.path.realpath(os.path.join(root, f)))
            elif f.startswith("test_") and f.endswith(".py"):
                if os.path.splitext(f)[0] in pyt_stems:
                    continue  # 被 .pyt 接管
                tests.add(os.path.realpath(os.path.join(root, f)))
    return sorted(tests)


def collect_tests(paths):
    """Resolve positional args into a sorted, de-duplicated list of test files.

    Each path may be:
      - a .py file   → included as-is (name need not match test_*.py)
      - a directory  → every test_*.py under it, recursively (no symlink follow)
    Every result is canonicalised with realpath so that the SAME test reached
    via different routes (e.g. qa/storage vs the qa/storage.latest symlink, or
    an explicit file that also lives under a given directory) collapses to one
    entry. This guarantees run_one always sees an identical test_dir/log_dir
    for a given case, regardless of how it was requested — so the run
    environment never varies with the input path.
    Non-existent paths abort with a clear error instead of being passed to fly.
    """
    collected = set()
    for p in paths:
        ap = os.path.abspath(p)
        # Resolve symlinks on the INPUT itself first, so a directory given via
        # its .latest symlink is treated as the real directory.
        rp = os.path.realpath(ap)
        if os.path.isdir(rp):
            hits = set()
            for root, dirs, files in os.walk(rp, followlinks=False):
                dirs[:] = [d for d in dirs if not _is_log_artifact(d)]
                pyt_stems = {os.path.splitext(f)[0] for f in files if f.endswith(".pyt")}
                for f in files:
                    if f.endswith(".pyt"):
                        hits.add(os.path.realpath(os.path.join(root, f)))
                    elif f.startswith("test_") and f.endswith(".py"):
                        if os.path.splitext(f)[0] in pyt_stems:
                            continue
                        hits.add(os.path.realpath(os.path.join(root, f)))
            if not hits:
                log(f"Warning: no test_*.py found under {p!r}")
            collected.update(hits)
        elif os.path.isfile(rp):
            collected.add(rp)
        else:
            log(f"Error: path does not exist: {p!r}")
            sys.exit(2)
    return sorted(collected)


def _is_log_artifact(name):
    """True for fly's per-test log residues that must never be scanned.

    - '{stem}.latest'  : symlink to the active log dir (fly's resolve_log_dir)
    - '{stem}.N'       : rotated historical log dirs (case.1, case.2, ...)
    - 'logs'           : multi-phase helper log tree
    - hidden dotfiles  : editor/OS cruft
    """
    if name.startswith("."):
        return True
    if name == "logs":
        return True
    if name.endswith(".latest"):
        return True
    # {stem}.N rotated dirs: suffix is all digits after the last dot, and there
    # is a stem before it (avoid treating 'foo.py' as an artifact).
    if "." in name:
        stem, _, suffix = name.rpartition(".")
        if stem and suffix.isdigit():
            return True
    return False


def _load_pyt(pyt_path):
    """Load a .pyt config file, returning a dict with setup/teardown callables.

    The pyt file is exec'd in a fresh namespace. Expected variables:
      - test (str, optional): the python test file name (defaults to pyt stem + ".py").
      - setup() (callable, optional): pre-test actions (create data, clean, set env).
      - teardown() (callable, optional): post-test cleanup.

    Returns:
        dict with keys 'test', 'setup', 'teardown' (setup/teardown may be None).
    """
    ns = {}
    with open(pyt_path) as f:
        exec(compile(f.read(), pyt_path, "exec"), ns)
    pyt_stem = os.path.splitext(os.path.basename(pyt_path))[0]
    return {
        "test": ns.get("test", pyt_stem + ".py"),
        "setup": ns.get("setup", None),
        "teardown": ns.get("teardown", None),
    }


class SubcaseResult:
    """单个 fly 进程（一个 sub case）的执行结果。"""
    def __init__(self, status, returncode, stdout, log_path, elapsed_ms):
        self.status = status            # PASSED / FAILED / TIMEOUT
        self.returncode = returncode
        self.stdout = stdout or b""
        self.log_path = log_path
        self.elapsed_ms = elapsed_ms
        self.ok = (status == "PASSED")  # raw ok（基于 returncode）；run_subcase 按 expect_pass 调整

    def tail(self, n=500):
        try:
            text = self.stdout.decode("utf-8", errors="replace")
        except Exception:
            return ""
        return text[-n:] if len(text) > n else text

    def __repr__(self):
        return f"SubcaseResult(status={self.status}, rc={self.returncode}, ms={self.elapsed_ms})"


class SubcaseError(Exception):
    """run_subcase 未达 expect_pass 期望时抛出 → .pyt exec 中断 → 整个 case 失败。"""
    def __init__(self, script, result, expect_pass):
        self.script = script
        self.result = result
        self.expect_pass = expect_pass
        want = "PASSED" if expect_pass else "FAILED"
        super().__init__(f"{script}: expected {want} but got {result.status}")


def _run_fly(script_path, log_dir, timeout, cwd, extra_env=None):
    """跑一个 fly 进程：subprocess + 超时 + SIGUSR1 stack dump + killpg + hang_stacks。
    fly stdout 写到 {log_dir}/fly.log。返回 SubcaseResult（status/returncode/stdout/log_path/elapsed）。
    被 run_one（test_*.py 路径）与 run_subcase（.pyt 的 sub case）共用。"""
    env = os.environ.copy()
    build_dir = os.path.dirname(os.path.dirname(FLY_BIN))
    lib_dir = os.path.join(build_dir, "lib")
    python_dir = os.path.join(build_dir, "python")
    env["LD_LIBRARY_PATH"] = lib_dir + ":" + env.get("LD_LIBRARY_PATH", "")
    env["PYTHONPATH"] = lib_dir + ":" + python_dir + ":" + env.get("PYTHONPATH", "")
    env["FLY_BUILD"] = build_dir
    if extra_env:
        env.update(extra_env)

    t0 = time.monotonic()
    # preexec_fn=os.setsid：fly + 其 worker 子进程放独立进程组，超时能 kill 整树。
    proc = subprocess.Popen(
        [FLY_BIN, "--log-dir", log_dir, script_path],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        cwd=cwd, env=env, preexec_fn=os.setsid,
    )

    timed_out = False
    try:
        stdout, _ = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        try:
            _pgid = os.getpgid(proc.pid)
        except ProcessLookupError:
            _pgid = None
        # SIGUSR1 触发 fly 内置 stack dump（写 {log_dir}/.fly.{pid}.stack 后 os._exit）
        try:
            import subprocess as _sp
            _usr1_pids = _sp.check_output(
                ["pgrep", "-f", r"[/]build/bin/fly"], stderr=_sp.DEVNULL
            ).split()
            for _cpid in _usr1_pids:
                _cpid = _cpid.decode().strip()
                try:
                    os.kill(int(_cpid), signal.SIGUSR1)
                except Exception:
                    pass
            import time as _stime
            _stime.sleep(2.0)
        except Exception:
            pass
        # /proc 内核栈 + py-spy Python 栈 → hang_stacks.txt
        try:
            import subprocess as _sp
            _diag = []
            _pids = _sp.check_output(
                ["pgrep", "-f", r"[/]build/bin/fly"], stderr=_sp.DEVNULL
            ).split()
            for _cpid in _pids:
                _cpid = _cpid.decode().strip()
                _cmdline = ""
                try:
                    _cmdline = open(f"/proc/{_cpid}/cmdline").read().replace("\0", " ")[:120]
                except Exception:
                    pass
                _diag.append(f"\n{'='*60}")
                _diag.append(f"pid={_cpid} cmd={_cmdline}")
                try:
                    for _tid in os.listdir(f"/proc/{_cpid}/task"):
                        _tcomm = _twchan = _tkstack = ""
                        try:
                            _tcomm = open(f"/proc/{_cpid}/task/{_tid}/comm").read().strip()
                        except Exception:
                            pass
                        try:
                            _twchan = open(f"/proc/{_cpid}/task/{_tid}/wchan").read().strip()
                        except Exception:
                            pass
                        try:
                            _tkstack = open(f"/proc/{_cpid}/task/{_tid}/stack").read().strip()
                        except Exception:
                            pass
                        if _tkstack:
                            _diag.append(f"  tid={_tid} comm={_tcomm} wchan={_twchan}")
                            _diag.append(f"    {_tkstack.split(chr(10))[0]}")
                except Exception:
                    pass
                try:
                    _py = _sp.check_output(
                        [os.path.expanduser("~/.local/bin/py-spy"), "dump", "--pid", _cpid],
                        stderr=_sp.DEVNULL, timeout=2).decode(errors="replace")
                    _diag.append(f"  Python stacks:\n{_py[:2000]}")
                except Exception:
                    pass
            if _diag:
                with open(os.path.join(log_dir, "hang_stacks.txt"), "w") as _f:
                    _f.write("\n".join(_diag))
        except Exception:
            pass
        if _pgid is not None:
            try:
                os.killpg(_pgid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        try:
            import subprocess as _sp
            _sp.call(["pkill", "-9", "-f", r"[/]build/bin/fly"],
                     stderr=_sp.DEVNULL, timeout=5)
        except Exception:
            pass
        stdout, _ = proc.communicate()

    elapsed_ms = int((time.monotonic() - t0) * 1000)
    rc = proc.returncode if proc.returncode is not None else -1
    ok_raw = (not timed_out) and proc.returncode == 0
    status = "TIMEOUT" if timed_out else ("PASSED" if ok_raw else "FAILED")

    out_log = os.path.join(log_dir, "fly.log")
    with open(out_log, "wb") as f:
        f.write(stdout or b"")

    return SubcaseResult(status=status, returncode=rc, stdout=stdout or b"",
                         log_path=out_log, elapsed_ms=elapsed_ms)


def run_subcase(script, timeout=30, setup=None, teardown=None, expect_pass=True, env=None):
    """跑一个 sub case（一个 fly 进程）。未达 expect_pass 期望 → raise SubcaseError
    （.pyt exec 中断，整个 case 失败）。

    script: sub case .py 路径（相对 FLY_CASE_DIR 或绝对）
    timeout: 单阶段超时秒
    setup/teardown: 无参 callable，sub case 级预处理/后处理（teardown 无论成败都跑）
    expect_pass: True=期望 fly PASSED；False=期望 fly FAILED（如测试失败场景）。
                 PASSED/TIMEOUT 在 expect_pass=False 时都算未达期望（场景没复现 / hang）。
    """
    case_dir = getattr(_case_state, "case_dir", os.getcwd())
    case_log_dir = getattr(_case_state, "log_dir", case_dir)
    n = run_subcase._counter
    run_subcase._counter += 1
    script_abs = script if os.path.isabs(script) else os.path.join(case_dir, script)
    script_stem = os.path.splitext(os.path.basename(script_abs))[0]
    sub_log_dir = os.path.join(case_log_dir, f"{n}_{script_stem}")
    os.makedirs(sub_log_dir, exist_ok=True)

    extra_env = {
        "FLY_CASE_DIR": case_dir,
        "FLY_CASE_LOG_DIR": case_log_dir,
        "FLY_CASE_SUB_DIR": sub_log_dir,
    }
    if env:
        extra_env.update(env)  # per-subcase env（如 FLY_DB_PATH），不污染全局 os.environ

    if setup:
        setup()
    result = _run_fly(script_abs, sub_log_dir, timeout, case_dir, extra_env)
    if teardown:
        teardown()

    if expect_pass:
        result.ok = (result.status == "PASSED")
    else:
        result.ok = (result.status == "FAILED")  # 仅 FAILED 接受；PASSED/TIMEOUT 都未达期望

    if not result.ok:
        raise SubcaseError(script, result, expect_pass)
    return result


run_subcase._counter = 0  # 每个 .pyt exec（run_pyt）重置
_case_state = threading.local()  # per-thread case 上下文（并发安全：-j 每 case 一线程，互不污染）


def _clean_case_logs(test_dir, stem):
    """清 case 的旧日志：{stem}/、{stem}.latest、{stem}.N 轮转、helper logs/<prefix>/。
    run_one（test_*.py）与 run_pyt（.pyt）共用，保证每次跑都是干净现场。"""
    import glob as _glob
    for variant in _glob.glob(os.path.join(test_dir, stem + "*")):
        tail = os.path.basename(variant)
        if tail == stem or tail == stem + ".latest" or (
            tail.startswith(stem + ".") and tail[len(stem) + 1:].isdigit()
        ):
            if os.path.islink(variant) or os.path.isfile(variant):
                os.remove(variant)
            elif os.path.isdir(variant):
                shutil.rmtree(variant, ignore_errors=True)
    helper_log_base = os.path.join(test_dir, "logs")
    if os.path.isdir(helper_log_base):
        helper_prefix = stem.replace("test_", "", 1)
        for entry in os.listdir(helper_log_base):
            entry_path = os.path.join(helper_log_base, entry)
            base = entry.split(".")[0]
            if base == helper_prefix or base.startswith(helper_prefix + "_"):
                if os.path.islink(entry_path) or os.path.isfile(entry_path):
                    os.remove(entry_path)
                elif os.path.isdir(entry_path):
                    shutil.rmtree(entry_path, ignore_errors=True)


def run_pyt(pyt_path, timeout=20):
    """exec 一个 .pyt 编排脚本。注入 run_subcase 等符号到 .pyt globals。
    .pyt 抛异常（SubcaseError/其他）→ case 失败；正常完成 → 成功。
    timeout 参数仅兼容统一调用入口（.pyt 整体无超时，sub case 各自超时）。"""
    abs_pyt = os.path.abspath(pyt_path)
    pyt_dir = os.path.dirname(abs_pyt)
    name = os.path.basename(abs_pyt)
    stem = os.path.splitext(name)[0]  # 去 .pyt 后缀

    log_dir = os.path.join(pyt_dir, stem)
    _clean_case_logs(pyt_dir, stem)

    run_subcase._counter = 0  # 每 case 重置 sub case 序号

    # thread_local 存 case 上下文（不污染全局 os.environ，-j 并发 case 互不干扰）。
    _case_state.case_dir = pyt_dir
    _case_state.log_dir = log_dir
    _case_state.stem = stem

    def pyt_INFO(msg=""):
        log(f"    {msg}")

    # FLY_CASE_* 注入为 .pyt 全局变量（.pyt 直接用 FLY_CASE_LOG_DIR 等，不依赖 os.environ）
    pyt_globals = {
        "__name__": "__main__",
        "__file__": abs_pyt,
        "__builtins__": __builtins__,
        "run_subcase": run_subcase,
        "SubcaseResult": SubcaseResult,
        "SubcaseError": SubcaseError,
        "INFO": pyt_INFO,
        "os": os, "sys": sys, "shutil": shutil,
        "FLY_CASE_DIR": pyt_dir,
        "FLY_CASE_LOG_DIR": log_dir,
        "FLY_CASE_STEM": stem,
    }

    t0 = time.monotonic()
    status = "PASSED"
    err_lines = []
    try:
        with open(abs_pyt) as f:
            code = compile(f.read(), abs_pyt, "exec")
        exec(code, pyt_globals)
    except SubcaseError as e:
        status = "FAILED"
        want = "PASSED" if e.expect_pass else "FAILED"
        err_lines.append(f"sub case {e.script}: expected {want} but got {e.result.status}")
        err_lines.append(f"  [log: {e.result.log_path}]")
        err_lines.extend(f"  {ln}" for ln in e.result.tail(1200).splitlines()[-12:])
    except SystemExit as e:
        status = "PASSED" if (e.code == 0 or e.code is None) else "FAILED"
        if status == "FAILED":
            err_lines.append(f"SystemExit({e.code})")
    except Exception as e:
        status = "FAILED"
        import traceback
        err_lines.append(f"{type(e).__name__}: {e}")
        err_lines.extend(traceback.format_exc().splitlines()[-15:])
    finally:
        pass  # thread_local per-thread，无需恢复（下次 run_pyt 覆盖）

    elapsed_ms = int((time.monotonic() - t0) * 1000)
    ok = (status == "PASSED")

    log(f"  {'✓ PASSED' if ok else '✗ ' + status}  {elapsed_ms:>6}ms  {name}")
    for line in err_lines:
        log(f"    {line}")

    return {"name": name, "ms": elapsed_ms, "ok": ok, "status": status, "log": log_dir}


def run_one(test_path, timeout=20):
    if test_path.endswith(".pyt"):
        return run_pyt(test_path, timeout)
    abs_test_path = os.path.abspath(test_path)
    test_dir = os.path.dirname(abs_test_path)
    name = os.path.basename(abs_test_path)
    stem = os.path.splitext(name)[0]

    # Check for pyt config (same stem, .pyt extension)
    pyt_path = os.path.join(test_dir, stem + ".pyt")
    pyt_cfg = None
    if os.path.isfile(pyt_path):
        try:
            pyt_cfg = _load_pyt(pyt_path)
        except Exception as e:
            log(f"  ✗ ERROR   pyt-load    {name} ({e})")
            return {"name": name, "ms": 0, "ok": False, "status": "ERROR",
                    "log": pyt_path}

    # Log directory: {test_dir}/{test_name}/
    log_dir = os.path.join(test_dir, stem)

    _clean_case_logs(test_dir, stem)

    t0 = time.monotonic()

    # ── pyt setup (pre-test actions: create data, clean, set env) ──
    if pyt_cfg and pyt_cfg["setup"] is not None:
        try:
            pyt_cfg["setup"]()
        except Exception as e:
            log(f"  ✗ ERROR   setup-fail  {name} ({e})")
            return {"name": name, "ms": 0, "ok": False, "status": "ERROR",
                    "log": log_dir}

    result = _run_fly(abs_test_path, log_dir, timeout, test_dir)

    # ── pyt teardown (post-test cleanup) ──
    if pyt_cfg and pyt_cfg["teardown"] is not None:
        try:
            pyt_cfg["teardown"]()
        except Exception as e:
            log(f"  WARNING  teardown-fail  {name} ({e})")

    log(f"  {'✓ PASSED' if result.ok else '✗ ' + result.status}  {result.elapsed_ms:>6}ms  {name}")

    if not result.ok:
        if result.status == "TIMEOUT":
            log(f"    (timed out after {timeout}s)")
        log(f"    [log: {result.log_path}]")
        for line in result.tail(1200).splitlines()[-15:]:
            if line.strip():
                log(f"    {line.rstrip()}")

    return {
        "name": name,
        "ms": result.elapsed_ms,
        "ok": result.ok,
        "status": result.status,
        "log": result.log_path,
    }


_MAX_PARALLEL = 32


def _resolve_max_workers(j):
    """Resolve the -j value to a ThreadPoolExecutor max_workers.

    - j > 0: that many workers, capped at _MAX_PARALLEL (32).
    - j == 0: unlimited, but still capped at 32 — unbounded parallelism lets
      heavy cases (e.g. n=500 coarse solve) starve each other for CPU/memory
      and time out, so we never actually run unbounded.
    - j < 0: treated as 0 (unlimited → capped).
    """
    if j <= 0:
        return _MAX_PARALLEL
    return min(j, _MAX_PARALLEL)


def _resolve_default_parallelism():
    """Compute the default -j based on CPU cores.

    Heavy solver tests each spawn nsd+1 worker processes doing CPU-bound numpy.
    Running 4 such tests concurrently on a 6-core box saturates all cores
    (loadavg >> nproc), starving the master reactor thread and causing message
    processing delays that trigger hangs/timeouts. Cap the default to leave
    headroom: at most min(nproc, 4), and on low-core boxes (< 8) use nproc-2
    to reserve cores for master reactor + OS.
    """
    try:
        nproc = os.cpu_count() or 4
    except NotImplementedError:
        nproc = 4
    if nproc <= 4:
        return max(1, nproc - 1)
    if nproc < 8:
        return max(2, nproc - 2)
    return 4


def _parallelism_label(j):
    """Human-readable parallelism label for the header."""
    if j <= 0:
        return f"unlimited (capped at {_MAX_PARALLEL})"
    if j > _MAX_PARALLEL:
        return f"{j} (capped at {_MAX_PARALLEL})"
    return str(j)


def main():
    global _log_file

    parser = argparse.ArgumentParser(
        description="Fly QA Test Runner",
        epilog="With no arguments, runs every test_*.py under qa/. A directory "
               "argument is scanned recursively for test_*.py.",
    )
    parser.add_argument("paths", nargs="*",
                        help="Test files and/or directories to run "
                             "(default: all test_*.py under qa/)")
    _default_j = _resolve_default_parallelism()
    parser.add_argument("-j", type=int, default=_default_j,
                        help=f"Max parallel tests (default={_default_j} based on CPU "
                             f"cores, max=32). 0=unlimited (capped at 32 to avoid "
                             f"overload-induced timeouts)")
    parser.add_argument("--no-shuffle", action="store_true",
                        help="Disable random test order (default: shuffle to spread "
                             "heavy solver tests among lightweight ones, reducing "
                             "concurrent CPU-bound load spikes)")
    parser.add_argument("-t", "--timeout", type=int, default=30,
                        help="Per-test timeout in seconds (default=30)")
    parser.add_argument("--fail-fast", action="store_true",
                        help="Stop on first failure (cancel remaining tests). "
                             "Preserves failed test logs from being overwritten.")
    args = parser.parse_args()

    if not os.path.isfile(FLY_BIN) or not os.access(FLY_BIN, os.X_OK):
        log("Installing fly binary...")
        subprocess.run(
            [os.path.join(PROJECT_ROOT, "fly.sh"), "build", "//src/main/cpp:fly"],
            cwd=PROJECT_ROOT, check=True,
        )
        subprocess.run(
            [os.path.join(PROJECT_ROOT, "fly.sh"), "install"],
            cwd=PROJECT_ROOT, check=True,
        )

    tests = collect_tests(args.paths) if args.paths else find_tests()

    # 随机打乱测试顺序（可 --no-shuffle 关闭）。
    # find_tests 返回 sorted 顺序，solver 等重测试（每个起 nsd+1 worker 做 CPU-bound
    # numpy）会聚集在一起，并发跑时瞬间打满 CPU。打乱后重测试分散到轻量测试之间，
    # 降低同一时刻多个重测试叠加的概率，缓解 CPU 饥饿导致的消息处理延迟。
    if not args.no_shuffle:
        import random
        shuffled = list(tests)
        random.shuffle(shuffled)
        tests = shuffled

    # Clean and create qa log directory
    qa_log_dir = os.path.join(SCRIPT_DIR, "logs")
    if os.path.isdir(qa_log_dir):
        shutil.rmtree(qa_log_dir)
    os.makedirs(qa_log_dir)

    _log_file = open(os.path.join(qa_log_dir, "qa.log"), "w")

    log("=" * 50)
    log("Fly QA Test Suite")
    log("=" * 50)
    log(f"Fly binary:   {FLY_BIN}")
    log(f"Tests to run: {len(tests)}")
    log(f"Parallelism:  {_parallelism_label(args.j)}")
    log(f"Timeout:      {args.timeout}s per test")
    log("=" * 50)
    log()

    max_workers = _resolve_max_workers(args.j)
    results = []
    t_total_start = time.monotonic()

    with ThreadPoolExecutor(max_workers=max_workers) as pool:
        futures = {pool.submit(run_one, t, args.timeout): t for t in tests}
        for fut in as_completed(futures):
            r = fut.result()
            results.append(r)
            if args.fail_fast and not r["ok"]:
                log(f"\n!!! FAIL-FAST: stopping after first failure: {r['name']}")
                log("!!! Remaining tests cancelled. Failed test logs preserved.")
                # Cancel all not-yet-started futures, then shutdown without waiting.
                for f in futures:
                    f.cancel()
                pool.shutdown(wait=False, cancel_futures=True)
                break

    total_ms = int((time.monotonic() - t_total_start) * 1000)

    results.sort(key=lambda r: r["ms"])

    passed = failed = 0
    failed_names = []

    log()
    log("=" * 50)
    log("Summary")
    log("=" * 50)
    for r in results:
        if r["ok"]:
            passed += 1
        else:
            failed += 1
            failed_names.append(r["name"])

    log(f"Passed:  {passed}")
    log(f"Failed:  {failed}")
    log(f"Total:   {total_ms}ms")

    _log_file.close()
    _log_file = None

    if failed:
        log()
        log("Failed tests:")
        for n in failed_names:
            log(f"  - {n}")
        sys.exit(1)

    log()
    log("All QA tests passed!")
    sys.exit(0)


if __name__ == "__main__":
    main()
