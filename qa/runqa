#!/usr/bin/env python3
"""Fly QA Test Runner.

Runs each test_*.py as a fly subprocess.
  - cd to test script directory before running
  - log directory: {test_dir}/{test_name}/ (cleaned before each run)
  - Fly's output → {test_dir}/{test_name}/fly.log
  - Runner's output → terminal + qa.log

Selecting which tests to run (zero, one, or many positional args):
  runqa                        # all test_*.py under qa/ (recursive)
  runqa qa/storage             # a directory → every test_*.py under it
  runqa qa/storage/test_x.py   # a single file
  runqa qa/storage qa/var      # multiple directories/files at once
  runqa qa/solver/test_gold*.py  # shell-globbed files also accepted

A directory is scanned recursively for test_*.py; an explicit .py file is run
as-is regardless of its name. Non-existent paths are rejected up front instead
of being passed to fly and failing with an opaque error.
"""
import subprocess
import sys
import os
import time
import argparse
import glob
import signal
import shutil
import threading
from concurrent.futures import ThreadPoolExecutor, as_completed

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
FLY_BIN = os.path.join(PROJECT_ROOT, "build", "bin", "fly")

_log_lock = threading.Lock()
_log_file = None


def log(msg=""):
    with _log_lock:
        print(msg, flush=True)
        if _log_file:
            _log_file.write(msg + "\n")
            _log_file.flush()


def find_tests():
    return sorted(glob.glob(os.path.join(SCRIPT_DIR, "**", "test_*.py"), recursive=True))


def collect_tests(paths):
    """Resolve positional args into a sorted, de-duplicated list of test files.

    Each path may be:
      - a .py file   → included as-is (name need not match test_*.py)
      - a directory  → every test_*.py under it, recursively
    Non-existent paths abort with a clear error so the caller never hands fly
    a bad path (which would surface as IsADirectoryError / FileNotFoundError
    from deep inside the runner).
    """
    collected = set()
    for p in paths:
        ap = os.path.abspath(p)
        if os.path.isdir(ap):
            hits = glob.glob(os.path.join(ap, "**", "test_*.py"), recursive=True)
            if not hits:
                log(f"Warning: no test_*.py found under {p!r}")
            collected.update(hits)
        elif os.path.isfile(ap):
            collected.add(ap)
        else:
            log(f"Error: path does not exist: {p!r}")
            sys.exit(2)
    return sorted(collected)


def run_one(test_path, timeout=20):
    abs_test_path = os.path.abspath(test_path)
    test_dir = os.path.dirname(abs_test_path)
    name = os.path.basename(test_path)
    stem = os.path.splitext(name)[0]

    # Log directory: {test_dir}/{test_name}/
    log_dir = os.path.join(test_dir, stem)

    # Clean all previous logs for this case, including nested helper logs.
    #
    # fly's Logger.resolve_log_dir creates ".N" variants (case.1, case.2, ...)
    # plus a "case.latest" symlink when the requested dir already exists.
    # Multi-phase tests also produce helper logs under test_dir/logs/.
    # We remove every variant and matching helper log so nothing accumulates.
    # We do NOT pre-create log_dir — resolve_log_dir creates it directly.
    import glob as _glob
    for variant in _glob.glob(os.path.join(test_dir, stem + "*")):
        tail = os.path.basename(variant)
        if tail == stem or tail == stem + ".latest" or (
            tail.startswith(stem + ".") and tail[len(stem) + 1:].isdigit()
        ):
            if os.path.islink(variant) or os.path.isfile(variant):
                os.remove(variant)
            elif os.path.isdir(variant):
                shutil.rmtree(variant, ignore_errors=True)

    # Clean helper log directories for multi-phase tests. Helpers write to
    # test_dir/logs/<group>/ (e.g. logs/wait_obj/, logs/frozen_db/). Each
    # group accumulates .N variants and .latest symlinks that must be cleaned.
    # We match by comparing helper names against the case stem (test_wait_obj
    # ↔ logs/wait_obj/). Safe under -j parallelism because each test only
    # removes its own helper group, not the entire logs/ tree.
    helper_log_base = os.path.join(test_dir, "logs")
    if os.path.isdir(helper_log_base):
        helper_prefix = stem.replace("test_", "", 1)
        for entry in os.listdir(helper_log_base):
            entry_path = os.path.join(helper_log_base, entry)
            base = entry.split(".")[0]  # strip .N / .latest suffix
            if base == helper_prefix or base.startswith(helper_prefix + "_"):
                if os.path.islink(entry_path) or os.path.isfile(entry_path):
                    os.remove(entry_path)
                elif os.path.isdir(entry_path):
                    shutil.rmtree(entry_path, ignore_errors=True)

    t0 = time.monotonic()

    # Set up environment based on FLY_BIN location
    env = os.environ.copy()
    # FLY_BIN is /root/fly/build/bin/fly, so build_dir is /root/fly/build
    build_dir = os.path.dirname(os.path.dirname(FLY_BIN))
    lib_dir = os.path.join(build_dir, "lib")
    python_dir = os.path.join(build_dir, "python")
    env["LD_LIBRARY_PATH"] = lib_dir + ":" + env.get("LD_LIBRARY_PATH", "")
    env["PYTHONPATH"] = lib_dir + ":" + python_dir + ":" + env.get("PYTHONPATH", "")
    env["FLY_BUILD"] = build_dir

    # Run test with cwd = test_dir. preexec_fn=os.setsid puts the fly process
    # (and the worker subprocesses it spawns) in their own process group, so a
    # timeout can kill the whole tree instead of orphaning workers.
    proc = subprocess.Popen(
        [FLY_BIN, "--log-dir", log_dir, abs_test_path],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        cwd=test_dir,
        env=env,
        preexec_fn=os.setsid,
    )

    # Capture output. A timeout must not crash the whole runner (it would
    # propagate through the ThreadPoolExecutor and abort every other test) —
    # kill the process group, salvage whatever output was produced, and mark
    # the test as FAILED with status TIMEOUT.
    timed_out = False
    try:
        stdout, _ = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except ProcessLookupError:
            pass
        # Drain the pipe so the child is fully reaped and we keep partial logs.
        stdout, _ = proc.communicate()

    elapsed_ms = int((time.monotonic() - t0) * 1000)
    ok = (not timed_out) and proc.returncode == 0
    status = "TIMEOUT" if timed_out else ("PASSED" if ok else "FAILED")

    # Write output to log file
    out_log = os.path.join(log_dir, "fly.log")
    with open(out_log, "wb") as f:
        f.write(stdout)

    log(f"  {'✓ PASSED' if ok else '✗ ' + status}  {elapsed_ms:>6}ms  {name}")

    if not ok:
        if timed_out:
            log(f"    (timed out after {timeout}s)")
        try:
            lines = stdout.decode("utf-8", errors="replace").split("\n")
            for line in lines[-10:]:
                if line.strip():
                    log(f"    {line.rstrip()}")
        except Exception:
            pass

    return {
        "name": name,
        "ms": elapsed_ms,
        "ok": ok,
        "status": status,
        "log": out_log,
    }


def main():
    global _log_file

    parser = argparse.ArgumentParser(
        description="Fly QA Test Runner",
        epilog="With no arguments, runs every test_*.py under qa/. A directory "
               "argument is scanned recursively for test_*.py.",
    )
    parser.add_argument("paths", nargs="*",
                        help="Test files and/or directories to run "
                             "(default: all test_*.py under qa/)")
    parser.add_argument("-j", type=int, default=0,
                        help="Max parallel tests (0=unlimited, default=0)")
    parser.add_argument("-t", "--timeout", type=int, default=20,
                        help="Per-test timeout in seconds (default=20)")
    args = parser.parse_args()

    if not os.path.isfile(FLY_BIN) or not os.access(FLY_BIN, os.X_OK):
        log("Installing fly binary...")
        subprocess.run(
            [os.path.join(PROJECT_ROOT, "fly.sh"), "build", "//src/main/cpp:fly"],
            cwd=PROJECT_ROOT, check=True,
        )
        subprocess.run(
            [os.path.join(PROJECT_ROOT, "fly.sh"), "install"],
            cwd=PROJECT_ROOT, check=True,
        )

    tests = collect_tests(args.paths) if args.paths else find_tests()

    # Clean and create qa log directory
    qa_log_dir = os.path.join(SCRIPT_DIR, "logs")
    if os.path.isdir(qa_log_dir):
        shutil.rmtree(qa_log_dir)
    os.makedirs(qa_log_dir)

    _log_file = open(os.path.join(qa_log_dir, "qa.log"), "w")

    log("=" * 50)
    log("Fly QA Test Suite")
    log("=" * 50)
    log(f"Fly binary:   {FLY_BIN}")
    log(f"Tests to run: {len(tests)}")
    log(f"Parallelism:  {'unlimited' if args.j == 0 else args.j}")
    log(f"Timeout:      {args.timeout}s per test")
    log("=" * 50)
    log()

    max_workers = None if args.j == 0 else args.j
    results = []
    t_total_start = time.monotonic()

    with ThreadPoolExecutor(max_workers=max_workers) as pool:
        futures = {pool.submit(run_one, t, args.timeout): t for t in tests}
        for fut in as_completed(futures):
            results.append(fut.result())

    total_ms = int((time.monotonic() - t_total_start) * 1000)

    results.sort(key=lambda r: r["ms"])

    passed = failed = 0
    failed_names = []

    log()
    log("=" * 50)
    log("Summary")
    log("=" * 50)
    for r in results:
        mark = "✓" if r["ok"] else "✗"
        if r["ok"]:
            passed += 1
        else:
            failed += 1
            failed_names.append(r["name"])

    log(f"Passed:  {passed}")
    log(f"Failed:  {failed}")
    log(f"Total:   {total_ms}ms")

    _log_file.close()
    _log_file = None

    if failed:
        log()
        log("Failed tests:")
        for n in failed_names:
            log(f"  - {n}")
        sys.exit(1)

    log()
    log("All QA tests passed!")
    sys.exit(0)


if __name__ == "__main__":
    main()
