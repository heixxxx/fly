#!/usr/bin/env python3
"""Fly QA Test Runner.

Runs each test_*.py as a fly subprocess.
  - Fly's output (C++ Logger + Python INFO/WARN/ERR) → {test_name}.log
  - Runner's own output → terminal + qa.log
"""
import subprocess
import sys
import os
import time
import argparse
import glob
from concurrent.futures import ThreadPoolExecutor, as_completed

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
FLY_BIN = os.path.join(PROJECT_ROOT, "build", "bin", "fly")

# ── Dual-output helper: terminal + qa.log ──

_log_file = None


def log(msg=""):
    """Print to both terminal and qa.log."""
    print(msg)
    if _log_file:
        _log_file.write(msg + "\n")
        _log_file.flush()


def find_tests():
    return sorted(glob.glob(os.path.join(SCRIPT_DIR, "test_*.py")))


def run_one(test_path, log_base):
    name = os.path.basename(test_path)
    stem = os.path.splitext(name)[0]
    log_dir = os.path.join(log_base, stem)
    out_log = os.path.join(log_base, f"{stem}.log")

    t0 = time.monotonic()
    proc = subprocess.run(
        [FLY_BIN, "--log-dir", log_dir, test_path],
        stdout=open(out_log, "w"),
        stderr=subprocess.STDOUT,
        cwd=PROJECT_ROOT,
    )
    elapsed_ms = int((time.monotonic() - t0) * 1000)

    return {
        "name": name,
        "ms": elapsed_ms,
        "ok": proc.returncode == 0,
        "log": out_log,
    }


def main():
    global _log_file

    parser = argparse.ArgumentParser(description="Fly QA Test Runner")
    parser.add_argument("test_file", nargs="?", help="Run a single test file")
    parser.add_argument("-j", type=int, default=0,
                        help="Max parallel tests (0=unlimited, default=0)")
    args = parser.parse_args()

    if not os.path.isfile(FLY_BIN) or not os.access(FLY_BIN, os.X_OK):
        log("Installing fly binary...")
        subprocess.run(
            [os.path.join(PROJECT_ROOT, "fly.sh"), "build", "//src/main/cpp:fly"],
            cwd=PROJECT_ROOT, check=True,
        )
        subprocess.run(
            [os.path.join(PROJECT_ROOT, "fly.sh"), "install"],
            cwd=PROJECT_ROOT, check=True,
        )

    if args.test_file:
        tests = [args.test_file]
    else:
        tests = find_tests()

    log_base = os.path.join(SCRIPT_DIR, "logs")
    import shutil
    if os.path.isdir(log_base):
        shutil.rmtree(log_base)
    os.makedirs(log_base)

    _log_file = open(os.path.join(log_base, "qa.log"), "w")

    log("=" * 42)
    log("Fly QA Test Suite")
    log("=" * 42)
    log(f"Fly binary: {FLY_BIN}")
    log(f"Test directory: {SCRIPT_DIR}")
    log(f"Tests to run: {len(tests)}")
    log(f"Parallelism: {'unlimited' if args.j == 0 else args.j}")
    log("=" * 42)
    log()

    max_workers = None if args.j == 0 else args.j
    results = []
    t_total_start = time.monotonic()

    with ThreadPoolExecutor(max_workers=max_workers) as pool:
        futures = {pool.submit(run_one, t, log_base): t for t in tests}
        for fut in as_completed(futures):
            results.append(fut.result())

    total_ms = int((time.monotonic() - t_total_start) * 1000)

    results.sort(key=lambda r: r["ms"])

    passed = failed = 0
    failed_names = []

    log("=" * 42)
    log("Results (sorted by duration)")
    log("=" * 42)
    for r in results:
        mark = "✓ PASSED" if r["ok"] else "✗ FAILED"
        log(f"  {mark}  {r['ms']:>6}ms  {r['name']}")
        if r["ok"]:
            passed += 1
        else:
            failed += 1
            failed_names.append(r["name"])
            with open(r["log"]) as f:
                lines = f.readlines()
            for line in lines[-20:]:
                log(f"    {line.rstrip()}")

    log()
    log("=" * 42)
    log("Summary")
    log("=" * 42)
    log(f"Passed:  {passed}")
    log(f"Failed:  {failed}")
    log(f"Total:   {total_ms}ms")

    _log_file.close()
    _log_file = None

    if failed:
        log()
        log("Failed tests:")
        for n in failed_names:
            log(f"  - {n}")
        sys.exit(1)

    log()
    log("All QA tests passed!")
    sys.exit(0)


if __name__ == "__main__":
    main()
