module(
    name = "fly",
    version = "0.1.0",
)

# =============================================================================
# BCR Dependencies
# =============================================================================

bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "fmt", version = "12.1.0")

# Python toolchain (use system Python)
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
)
use_repo(python, "python_3_12")

# Third-party Python packages (cloudpickle / numpy / scipy / pytest) via pip.
# pip.parse reads the pinned lock (requirements_lock.txt, generated from
# requirements.in by pip-compile) and exposes a @pip hub. BUILD files pull
# individual packages via `load("@pip//:requirements.bzl", "requirement")` and
# `requirement("<pkg>")` in deps. This makes py_test hermetic (wheels come from
# the bazel sandbox, not the system site-packages) and gives fly.sh install a
# canonical source to copy wheels from into build/ for the production binary.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pip")

# =============================================================================
# Non-BCR Dependencies (via http_archive with custom BUILD files)
# =============================================================================

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# nanobind - thin C++/Python bindings
http_archive(
    name = "nanobind",
    strip_prefix = "nanobind-2.12.0",
    urls = ["https://github.com/wjakob/nanobind/archive/refs/tags/v2.12.0.tar.gz"],
    build_file = "//third_party:nanobind.BUILD",
)

# bitsery - header-only C++ serialization library
http_archive(
    name = "bitsery",
    strip_prefix = "bitsery-5.2.4",
    urls = ["https://github.com/fraillt/bitsery/archive/refs/tags/v5.2.4.tar.gz"],
    build_file = "//third_party:bitsery.BUILD",
)

# robin_map - fast hash map used by nanobind
http_archive(
    name = "robin_map",
    strip_prefix = "robin-map-1.3.0",
    urls = ["https://github.com/Tessil/robin-map/archive/refs/tags/v1.3.0.tar.gz"],
    build_file = "//third_party:robin_map.BUILD",
)

# Eigen - header-only C++ linear algebra library
http_archive(
    name = "eigen",
    build_file = "//third_party:eigen.BUILD",
    strip_prefix = "eigen-3.4.0",
    urls = ["https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz"],
)

# compile_commands.json now generated by tools/refresh_compile_commands/refresh.py
# (replaced hedron_compile_commands — native.py_binary removed in Bazel 9)
