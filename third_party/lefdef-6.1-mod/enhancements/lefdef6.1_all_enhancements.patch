+             ch = GETC();
+             if ((ch == '\n') || (ch == EOF)) {
+                 *s = '\0';
+                 return FALSE;
+             }
+          }
+
           *s = ch;
           IncCurPos(&s, buf, bufferSize);        
        }
@@ -401,6 +409,14 @@ defrData::DefGetToken(char **buf, int *bufferSize)
           if (ch == ' ' || ch == '\t' || ch == '\n' || ch == EOF)
