From c4d74d650a331a8006dbff9c11f48a336ac80533 Mon Sep 17 00:00:00 2001
From: blank <583957236@qq.com>
Date: Fri, 3 Apr 2026 10:11:48 +0800
Subject: [PATCH 6/8] refactor(def): rename ProcessEscapeInTString to
 RemoveBackslash

- Rename defrSetProcessEscapeInTString to defrSetRemoveBackslash
- Rename ProcessEscapeInTString flag to RemoveBackslash
- More concise and clearer API name
---
 def/TEST/generate_test_def.py | 12 +++++-------
 def/def/def_keywords.cpp      |  4 ++--
 def/def/defrReader.cpp        |  4 ++--
 def/def/defrReader.hpp        |  2 +-
 def/def/defrSettings.cpp      |  2 +-
 def/def/defrSettings.hpp      |  2 +-
 6 files changed, 12 insertions(+), 14 deletions(-)

diff --git a/def/TEST/generate_test_def.py b/def/TEST/generate_test_def.py
index e31bb5c..0accb48 100644
--- a/def/TEST/generate_test_def.py
+++ b/def/TEST/generate_test_def.py
@@ -10,18 +10,16 @@ UNITS DISTANCE MICRONS 1000 ;
 
 """)
 
-    # COMPONENTS section - 100000 components, 50% with escape
-    f.write("COMPONENTS 100000 ;\n")
-    for i in range(1, 100001):
+    f.write("COMPONENTS 10000000 ;\n")
+    for i in range(1, 10000001):
         if i % 2 == 0:
             f.write(f"- inst_{i}\\[1\\]/module_{i}\\[2\\] MACRO ;\n")
         else:
             f.write(f"- inst_{i} MACRO ;\n")
     f.write("END COMPONENTS\n\n")
 
-    # NETS section - 100000 nets, 50% with escape
-    f.write("NETS 100000 ;\n")
-    for i in range(1, 100001):
+    f.write("NETS 10000000 ;\n")
+    for i in range(1, 10000001):
         if i % 2 == 0:
             f.write(f"- net_{i}\\[1\\]/subnet_{i}\\[2\\] ;\n")
         else:
@@ -30,4 +28,4 @@ UNITS DISTANCE MICRONS 1000 ;
 
     f.write("END DESIGN\n")
 
-print("Generated test_escape_large.def")
\ No newline at end of file
+print("Generated test_escape_large.def with 10M components and 10M nets")
\ No newline at end of file
diff --git a/def/def/def_keywords.cpp b/def/def/def_keywords.cpp
index 48c00ea..8490b44 100755
--- a/def/def/def_keywords.cpp
+++ b/def/def/def_keywords.cpp
@@ -383,7 +383,7 @@ defrData::DefGetToken(char **buf, int *bufferSize)
           if (ch == ' ' || ch == '\t' || ch == '\n' || ch == EOF)
              break;
 
-          if (settings->ProcessEscapeInTString && ch == '\\') {
+          if (settings->RemoveBackslash && ch == '\\') {
