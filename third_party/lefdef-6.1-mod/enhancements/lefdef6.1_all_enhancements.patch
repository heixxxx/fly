+static inline const DefKeywordEntry* defFindKeyword(const char *str, size_t len) {
+  if (len >= 1 && len <= 30) {
+    unsigned int key = defKeywordHash(str, len);
+    if (key <= 585) {
+      const char *s = defKeywordList[key].name;
+      if (s != 0 && *str == *s && strcmp(str + 1, s + 1) == 0)
+        return &defKeywordList[key];
+    }
+  }
+  return 0;
+}
