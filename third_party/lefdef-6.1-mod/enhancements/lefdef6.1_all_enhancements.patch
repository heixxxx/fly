+void
+defrData::skip_section(const char* end_keyword)
+{
+    int ch;
+    char token_buf[128];
+    int token_len = 0;
+    int found_end = 0;
+    
+    while ((ch = GETC()) != EOF) {
+        if (ch == '\n') {
+            print_lines(++nlines);
+            if (token_len > 0) {
+                token_buf[token_len] = '\0';
+                if (found_end && strcmp(token_buf, end_keyword) == 0) {
+                    UNGETC(ch);  // Put back newline for parser
+                    return;  // Found END <keyword>, let parser handle it
+                }
