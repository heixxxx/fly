VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN test_design ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;

COMPONENTS 2 ;
- inst1 PAD_IN + PLACED ( 0 0 ) N ;
- inst2 PAD_OUT + PLACED ( 10000 10000 ) N ;
END COMPONENTS

SPECIALNETS 1 ;
- special_net1
  ( inst1 pin1 ) ( inst2 pin2 )
  + ROUTED metal1 280 ( 100 100 140 ) ( 200 200 140 )
  NEW metal1 280 ( 200 200 140 ) ( 300 300 140 )
  NEW metal1 280 ( 300 300 140 ) ( 400 400 140 )
  NEW metal1 280 ( 400 400 140 ) ( 500 500 140 )
  NEW metal1 280 ( 500 500 140 ) ( 600 600 140 )
  NEW metal1 280 ( 600 600 140 ) ( 700 700 140 )
  NEW metal1 280 ( 700 700 140 ) ( 800 800 140 )
  NEW metal1 280 ( 800 800 140 ) ( 900 900 140 )
  NEW metal1 280 ( 900 900 140 ) ( 1000 1000 140 )
  NEW metal1 280 ( 1000 1000 140 ) ( 1100 1100 140 )
  + USE SIGNAL ;
END SPECIALNETS

END DESIGN
