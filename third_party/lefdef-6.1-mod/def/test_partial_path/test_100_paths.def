VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN test_design ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;

COMPONENTS 2 ;
- inst1 PAD_IN + PLACED ( 0 0 ) N ;
- inst2 PAD_OUT + PLACED ( 10000 10000 ) N ;
